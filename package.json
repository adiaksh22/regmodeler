{
  "name": "regmodeler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src vite.config.ts vitest.config.ts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start -x realtime,studio,edge-runtime,logflare,vector,supavisor,imgproxy",
    "db:stop": "supabase stop",
    "db:test": "node scripts/test-database.mjs",
    "db:env": "node scripts/local-env.mjs",
    "api:test": "node --env-file=.env.local scripts/test-api.mjs",
    "worker:check": "node --env-file-if-exists=.env.local apps/worker/src/index.mjs",
    "worker:test": "node --test apps/worker/test/*.test.mjs",
    "import:verify": "node --env-file-if-exists=.env.local apps/worker/src/import-tcds.mjs --verify-only",
    "import:tcds": "node --env-file-if-exists=.env.local apps/worker/src/import-tcds.mjs",
    "check": "npm run lint && npm test && npm run worker:test && npm run db:test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-table": "^8.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "supabase": "2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.0"
  }
}
